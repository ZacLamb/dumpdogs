<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta http-equiv="refresh" content="120">
<title>Dashboard | <%= business.short %></title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f3efe6; --panel: #fff; --ink: #0c0c0c; --txt: #1b1b1b; --mute: #6b665d; --line: #e4ddcf;
    --red: #d7191f; --red-hi: #ef2a30; --bar: #d7191f; --bar-2: #1b1b1b; --good: #2e7d32;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0e0e0e; --panel: #181818; --ink: #000; --txt: #ece7dc; --mute: #9b958a; --line: #2a2a2a; --bar-2: #ece7dc; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--txt); font: 15px/1.5 'Barlow', system-ui, sans-serif; }
  a { color: var(--red); }
  header { background: #0c0c0c; color: #fff; border-bottom: 4px solid var(--red); }
  .wrap { max-width: 1240px; margin: 0 auto; padding: 0 16px; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 14px 16px; }
  .brand { font: 400 1.5rem/1 'Anton', Impact, sans-serif; text-transform: uppercase; letter-spacing: .02em; }
  .brand small { display: block; font: 700 .72rem/1.4 'Barlow Condensed', sans-serif; letter-spacing: .2em; color: var(--red-hi); }
  .range { display: flex; gap: 6px; flex-wrap: wrap; }
  .range a, .range button { font: 700 .85rem/1 'Barlow Condensed', sans-serif; letter-spacing: .08em; text-transform: uppercase; padding: 9px 12px; border: 2px solid #444; color: #fff; text-decoration: none; background: transparent; border-radius: 3px; cursor: pointer; }
  .range a.on { background: var(--red); border-color: var(--red); }
  .range a:hover, .range button:hover { border-color: #fff; }
  main { padding: 22px 0 60px; }
  .note { padding: 10px 14px; border-left: 5px solid var(--red); background: var(--panel); margin-bottom: 18px; font-size: .92rem; }
  .note.ok { border-color: var(--good); }
  .kpis { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; margin-bottom: 18px; }
  .kpi { background: var(--panel); border: 1px solid var(--line); border-top: 5px solid var(--ink); padding: 14px 16px; border-radius: 3px; }
  @media (prefers-color-scheme: dark) { .kpi { border-top-color: var(--red); } }
  .kpi b { display: block; font: 400 2.3rem/1 'Anton', Impact, sans-serif; }
  .kpi span { font: 700 .75rem/1.2 'Barlow Condensed', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--mute); }
  .kpi.hot { border-top-color: var(--red); }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 14px; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 3px; padding: 16px 18px; min-width: 0; }
  .card h2 { margin: 0 0 12px; font: 800 1rem/1 'Barlow Condensed', sans-serif; letter-spacing: .14em; text-transform: uppercase; }
  .span2 { grid-column: 1 / -1; }
  .chart { display: flex; align-items: flex-end; gap: 3px; height: 170px; border-bottom: 2px solid var(--txt); padding-top: 18px; }
  .col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; min-width: 0; position: relative; }
  .bar { width: 100%; max-width: 34px; background: var(--bar); border-radius: 2px 2px 0 0; min-height: 2px; }
  .col em { position: absolute; top: -16px; font-style: normal; font: 700 .72rem/1 'Barlow Condensed', sans-serif; color: var(--mute); }
  .xl { display: flex; gap: 3px; margin-top: 6px; }
  .xl span { flex: 1; text-align: center; font-size: .68rem; color: var(--mute); white-space: nowrap; overflow: hidden; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { display: grid; grid-template-columns: 1fr auto; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--line); position: relative; }
  .rows li:last-child { border-bottom: 0; }
  .rows .fill { position: absolute; left: 0; bottom: -1px; height: 3px; background: var(--red); opacity: .55; }
  .rows b { font-variant-numeric: tabular-nums; }
  .empty { color: var(--mute); font-size: .92rem; }
  .feed { list-style: none; margin: 0; padding: 0; max-height: 560px; overflow: auto; }
  .feed li { padding: 10px 0; border-bottom: 1px solid var(--line); }
  .feed .who { font-weight: 700; }
  .feed .lead { color: var(--red); }
  .tag { display: inline-block; font: 700 .68rem/1 'Barlow Condensed', sans-serif; letter-spacing: .1em; text-transform: uppercase; padding: 3px 6px; border-radius: 2px; background: var(--red); color: #fff; margin-left: 6px; vertical-align: 2px; }
  .meta { color: var(--mute); font-size: .82rem; }
  .pages { font-size: .88rem; margin-top: 3px; }
  .tbl { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .tbl th { text-align: left; font: 700 .74rem/1 'Barlow Condensed', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: var(--mute); padding: 8px 8px 8px 0; border-bottom: 2px solid var(--txt); }
  .tbl td { padding: 9px 8px 9px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .tblwrap { overflow-x: auto; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  footer { color: var(--mute); font-size: .8rem; margin-top: 24px; }
  @media (max-width: 980px) { .kpis { grid-template-columns: repeat(3, 1fr); } .grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .kpis { grid-template-columns: repeat(2, 1fr); } .kpi b { font-size: 1.9rem; } .xl span:nth-child(even) { visibility: hidden; } }
</style>
</head>
<body>
<header>
  <div class="wrap top">
    <div class="brand"><%= business.short %><small>Website dashboard</small></div>
    <div class="range">
      <% [7, 30, 90].forEach(d => { %><a href="/dashboard?days=<%= d %>" class="<%= s.days === d ? 'on' : '' %>"><%= d %> days</a><% }) %>
      <form method="post" action="/dashboard/send-digest" style="margin:0"><button type="submit" title="Email yesterday's summary now">Send digest now</button></form>
    </div>
  </div>
</header>
<main class="wrap">
  <% if (sent === '1') { %><div class="note ok">Digest sent to the alert email.</div><% } else if (sent === '0') { %><div class="note">Digest couldn't be sent — check that ALERT_WEBHOOK_URL is set in Railway.</div><% } %>
  <% if (s.storage === 'file') { %><div class="note">Visits are being stored temporarily and reset when the site redeploys. Add a Postgres database to this Railway project and set <code>DATABASE_URL</code> to keep history.</div><% } %>

  <section class="kpis">
    <div class="kpi"><b><%= s.totals.visits %></b><span>Visits</span></div>
    <div class="kpi"><b><%= s.totals.visitors %></b><span>Unique visitors</span></div>
    <div class="kpi"><b><%= s.totals.views %></b><span>Page views</span></div>
    <div class="kpi hot"><b><%= s.totals.leads %></b><span>Quote requests</span></div>
    <div class="kpi"><b><%= s.totals.conversion %>%</b><span>Visitor → lead</span></div>
    <div class="kpi hot"><b><%= s.totals.returning %></b><span>Leads came back</span></div>
  </section>

  <div class="grid">
    <section class="card span2">
      <h2>Visits per day</h2>
      <% const max = Math.max(1, ...s.daily.map(d => d.visits)); const step = s.days > 30 ? 7 : s.days > 7 ? 3 : 1; %>
      <div class="chart" role="img" aria-label="Visits per day over the last <%= s.days %> days">
        <% s.daily.forEach(d => { %><div class="col" title="<%= d.day %>: <%= d.visits %> visits, <%= d.views %> page views"><% if (s.days <= 30 && d.visits) { %><em style="bottom:<%= (d.visits / max) * 100 %>%"><%= d.visits %></em><% } %><div class="bar" style="height:<%= (d.visits / max) * 100 %>%"></div></div><% }) %>
      </div>
      <div class="xl"><% s.daily.forEach((d, i) => { const dt = new Date(d.day + 'T12:00:00'); %><span><%= (i % step === 0 || i === s.daily.length - 1) ? (dt.getMonth() + 1) + '/' + dt.getDate() : '' %></span><% }) %></div>
    </section>

    <section class="card">
      <h2>Live visitor feed</h2>
      <% if (!s.feed.length) { %><p class="empty">No visits yet in this range.</p><% } %>
      <ul class="feed">
        <% s.feed.forEach(f => { %>
        <li>
          <span class="who <%= f.isLead ? 'lead' : '' %>"><%= f.who %></span><% if (f.isLead) { %><span class="tag">Lead</span><% } %>
          <div class="meta"><%= f.when %> · <%= f.source %> · <%= f.device %> · <%= f.pages.length %> page<%= f.pages.length === 1 ? '' : 's' %></div>
          <div class="pages"><%= f.pages.join(' → ') %></div>
        </li>
        <% }) %>
      </ul>
    </section>

    <div style="display:grid;gap:14px;align-content:start;min-width:0">
      <% const listCard = (title, arr, empty) => { const m = Math.max(1, ...arr.map(x => x[1])); %>
      <section class="card">
        <h2><%= title %></h2>
        <% if (!arr.length) { %><p class="empty"><%= empty %></p><% } else { %>
        <ul class="rows"><% arr.forEach(([k, n]) => { %><li><span><%= k %></span><b><%= n %></b><i class="fill" style="width:<%= (n / m) * 100 %>%"></i></li><% }) %></ul>
        <% } %>
      </section>
      <% }; %>
      <% listCard('Where visitors come from', s.sources, 'No visits yet.') %>
      <% listCard('Top pages', s.pages, 'No visits yet.') %>
      <% listCard('Towns people look at', s.towns, 'No town pages viewed yet.') %>
      <% listCard('Devices', s.devices, 'No visits yet.') %>
    </div>

    <section class="card span2">
      <h2>Leads from the website</h2>
      <% if (!s.leads.length) { %><p class="empty">No quote requests yet. When someone submits the form, they'll show up here — and you'll get an alert each time they come back.</p><% } else { %>
      <div class="tblwrap">
      <table class="tbl">
        <thead><tr><th>Name</th><th>Phone</th><th>Town</th><th>Size</th><th>Found you via</th><th>Requested</th><th class="num">Visits</th><th>Last seen</th></tr></thead>
        <tbody>
          <% s.leads.forEach(l => { %>
          <tr>
            <td><b><%= l.name || '—' %></b><% if (l.email) { %><div class="meta"><a href="mailto:<%= l.email %>"><%= l.email %></a></div><% } %></td>
            <td><% if (l.phone) { %><a href="tel:<%= l.phone %>"><%= l.phone %></a><% } else { %>—<% } %></td>
            <td><%= l.town || '—' %></td>
            <td><%= l.size || '—' %></td>
            <td><%= l.source || '—' %></td>
            <td><%= l.created %></td>
            <td class="num"><%= l.visits %></td>
            <td><%= l.lastSeen %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>
  </div>

  <footer>Times shown in <%= s.tz.replace('_', ' ') %>. Your own visits aren't counted once you've logged in here. Refreshes every 2 minutes.</footer>
</main>
</body>
</html>
