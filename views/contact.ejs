<%- include('partials/head') %>
<%- include('partials/phero', { crumbs: [['Contact']], kicker: 'Book a dumpster', h1: 'Let\'s get you <span class="red">a dumpster.</span>', lead: 'Call or text for the fastest answer, or send a request below and we\'ll get right back to you.' }) %>
<section class="sec">
  <div class="wrap split split--form">
    <div>
      <% if (sent) { %><div class="alert">Thanks — your request came through. We'll be in touch shortly.</div><% } %>
      <div class="contact-cards">
        <a class="ccard" href="tel:<%= business.phoneHref %>"><%- include('partials/icon', {name:'phone'}) %><span>Call or text</span><b><%= business.phone %></b></a>
        <a class="ccard" href="mailto:<%= business.email %>"><%- include('partials/icon', {name:'tag'}) %><span>Email</span><b><%= business.email %></b></a>
        <div class="ccard"><%- include('partials/icon', {name:'pin'}) %><span>Yard</span><b><%= business.street %>, <%= business.city %>, <%= business.state %> <%= business.zip %></b></div>
      </div>
      <iframe class="map" title="Map of Dumpster Dawgs in Wareham, MA" loading="lazy" src="https://maps.google.com/maps?q=<%= encodeURIComponent(business.street + ', ' + business.city + ', ' + business.state + ' ' + business.zip) %>&z=12&output=embed"></iframe>
    </div>
    <%- include('partials/form', { formSize: formSize }) %>
  </div>
</section>
<%- include('partials/foot') %>
