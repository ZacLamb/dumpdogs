  <div class="wrap">
    <div class="gal gal--full">
      <% img.gallery.forEach((g,i) => { %><figure class="gal__i"><img src="<%= g %>" alt="Dumpster Dawgs job photo <%= i+1 %>" loading="lazy"></figure><% }) %>
